{
  "agy-metrics-collector": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 -S ./hooks/run_hook.py SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 -S ./hooks/run_hook.py PreInvocation",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S ./hooks/run_hook.py PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 -S ./hooks/run_hook.py PostInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 -S ./hooks/run_hook.py Stop",
        "timeout": 5
      }
    ]
  }
}
